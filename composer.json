{
    "name": "jadu/emoji-bundle",
    "description": "A Symfony2 bundle for the jadu/emoji component",
    "keywords": ["emoji"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.2.5",
        "jadu/emoji": "^1.0.0",
        "symfony/framework-bundle": "^5.0",
        "symfony/yaml": "^5.0 || ^6.0 || ^7.0",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Jadu\\EmojiBundle\\": "src/"
        }
    }
}
